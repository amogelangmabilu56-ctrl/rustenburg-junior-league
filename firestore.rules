rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      // Replace with the email of your admin user in Firebase Authentication
      allow write: if request.auth != null
                   && request.auth.token.email == 'PUT-YOUR-ADMIN-EMAIL-HERE';
    }
  }
}
