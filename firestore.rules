rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Put the email address of every RJL admin login in this list.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['ADMIN_EMAIL_HERE'];
    }

    match /teams/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /players/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /fixtures/{id} { allow read: if true; allow write: if isAdmin(); }

    // Block everything else
    match /{document=**} { allow read, write: if false; }
  }
}
